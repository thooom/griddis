{
  "name": "griddis",
  "version": "0.1.0",
  "description": "Framework-agnostic dashboard widget system for web applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/griddis.cjs",
  "module": "./dist/griddis.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/griddis.js",
      "require": "./dist/griddis.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "dashboard",
    "grid",
    "widgets",
    "drag-drop",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thooom/griddis.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
